  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Think of an ice skating game - you need to tell the skater what 'tricks'
    to perform depending on the mood of the judges - each judge has a particular
    like - \nJump\nDouble Jump\nTriple Jump\nSpin\nFast Spin\nDouble Twist Jump\nTriple
    Twist Jump\nElegant Pose\nIce Dance Step\n\n\nJudge A loves Jumps\nJudge B loves
    Spins\nJudge C loves Twists\nJudge D loves Artistic Moves\n\nFor each judge allocate
    marks depending on your routine -\n\nMake the player have 10 seconds to construct
    the best routine from 6 available tricks.\n\nExample flow:\n\n\"Head Judge: Anna\"\nPlayer
    picks 3 tricks.\nRoutine submitted.\nAll judges score it.\nRoutine passes if
    average score > threshold.\n\nChange button sizes - on click shows the difficulty
    and and mini graph for how it will be recieved - you have 10 seconds to choose
    the routine - then 15 seonds to perform it - countdown timer for each part of
    the routine - must complete what yu choose or docked points. Difficulty determines
    whether the part can be completed successfully - using a meter timer."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
